# API adresi. Bu dosyayı ".env" adıyla kopyalayıp değeri değiştirin.
# Boş bırakılırsa veya dosya yoksa http://localhost:5007 kullanılır.
#
# Yerel geliştirme:
VITE_API_URL=http://localhost:5007
#
# Sunucuya yüklerken örnek:
# VITE_API_URL=https://api.sirketiniz.com
#
# Tester rolü/arayüzü: Vite dev'de otomatik açık. Production derlemesinde:
# VITE_BETA_ENABLED=true
# (API tarafında da BETA_ENABLED=true veya Development olmalı.)
