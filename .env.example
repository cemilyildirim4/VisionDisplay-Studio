# Bu dosyayi ".env" adiyla kopyalayip degerleri kendinize gore degistirin:
#   cp .env.example .env
#
# Gercek sifreleri asla git'e eklemeyin. docker-compose.yml bu degerleri okur.

# Development | Production. Canliya cikarken Production yapin.
ASPNETCORE_ENVIRONMENT=Development

# --- Veritabani ---
# Postgres ve API ayni parolayi kullanir. Bos birakilirsa compose/API baslamaz.
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
# Istege bagli; DB_PASSWORD yoksa buna dusulur.
POSTGRES_PASSWORD=

# pgAdmin (http://localhost:5050) — varsayilan parola yok.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD

# --- JWT ---
# En az 32 karakter, rastgele bir sir. Ornek: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS________

# --- Yonetim ---
# Paylasilan X-Admin-Key kaldirildi. Bu degisken API tarafindan okunmaz;
# ilk Admin hesabi paneldeki bootstrap formu veya POST /api/users/bootstrap-admin ile acilir.
ADMIN_PASSWORD=

# --- Personel kayit kodu (Tester) ---
STAFF_TESTER_CODE=

# Frontend API adresi (build-time).
# Gelistirme (Vite): BOS birakin → istekler /api uzerinden proxy gider.
# Docker gelistirme: http://localhost:5007
# Canli (nginx /api proxy): BOS birakin.
VITE_API_URL=

# --- CORS ---
# Virgulle ayrilmis tam origin listesi. Production'da * yasak ve bos olamaz.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- TLS (yalnizca docker-compose.prod.yml) ---
# Let's Encrypt ornegi: /etc/letsencrypt/live/ornek.com
# Klasorde fullchain.pem ve privkey.pem olmali; nginx uid 101 okuyabilmeli.
DOMAIN=example.com
SSL_CERT_DIR=/etc/letsencrypt/live/example.com

# --- Beta asamasi ---
# true: yazma uclari davet kodu / oturum ister. Canlida false.
BETA_ENABLED=false

# --- Google ile giris (opsiyonel) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- E-posta bildirimleri (opsiyonel) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATIONS_ADMIN_EMAIL=
