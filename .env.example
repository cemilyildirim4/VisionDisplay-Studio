# Bu dosyayi ".env" adiyla kopyalayip degerleri kendinize gore degistirin:
#   cp .env.example .env
#
# docker-compose.yml bu degerleri okur.

POSTGRES_PASSWORD=postgrespassword
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=adminpassword

# Yonetim paneli erisimi:
#  1) Tercih edilen: Role=Admin JWT hesabi (panelde "Admin hesap" veya "Ilk Admin")
#  2) Yedek / beta: asagidaki paylasilan parola (X-Admin-Key)
# Bos birakilirsa yalnizca JWT Admin kabul edilir (canliya yakin).
ADMIN_PASSWORD=

# Frontend API adresi (build-time).
# Gelistirme (Vite): BOS birakin → istekler /api uzerinden Vite proxy ile
#   http://127.0.0.1:5007'ye gider (CORS/kopma daha az).
# Docker / uretim: tarayicidan erisilebilir tam adres, orn:
#   VITE_API_URL=http://localhost:5007
VITE_API_URL=

# --- Bayi/musteri girisi (JWT) ---
# En az 32 karakter, rastgele bir sir. Ornek uretim: openssl rand -base64 48
JWT_SECRET=

# --- Beta asamasi ---
# true yapilirsa herkese acik POST uclari (teklif/konfigurasyon/sohbet) davet
# kodu veya giris yapmis kullanici jetonu ister. Canliya cikinca false yapin.
BETA_ENABLED=false

# --- Google ile giris (opsiyonel) ---
# https://console.cloud.google.com/apis/credentials adresinden alinir. Bos
# birakilirsa Google girisi backend'de otomatik devre disi kalir.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- E-posta bildirimleri (opsiyonel) ---
# Bos birakilirsa e-posta gonderilmez, yalnizca loglanir.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Yeni teklif geldiginde bildirim gidecek yonetici adresi.
NOTIFICATIONS_ADMIN_EMAIL=
